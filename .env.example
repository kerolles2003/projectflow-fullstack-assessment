# Copy this file to .env in the repository root before starting the apps.

# --- API ---
# Requires an initialized local replica set named rs0; standalone MongoDB is insufficient.
# Replace <published-port> with the host port from: docker port projectflow-local 27017
MONGODB_URI=mongodb://127.0.0.1:<published-port>/projectflow?replicaSet=rs0&directConnection=true
JWT_SECRET=local-development-secret
JWT_EXPIRES_IN=7d
API_PORT=4732
WEB_ORIGIN=http://localhost:3742

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4732
